import matplotlib.pyplot as plt
import numpy as np
import time

# Инициализация начальных данных
initial_air_pollution = 50
initial_wind_speed = 5
initial_wind_direction = 0

def generate_data(last_air_pollution, last_wind_speed, last_wind_direction):
    delta_pollution = (np.random.rand() - 0.5) * 10
    delta_speed = (np.random.rand() - 0.5) * 2
    delta_direction = (np.random.rand() - 0.5) * 20

    new_air_pollution = last_air_pollution + delta_pollution
    new_wind_speed = max(0, last_wind_speed + delta_speed)
    new_wind_direction = (last_wind_direction + delta_direction) % 360

    return new_air_pollution, new_wind_speed, new_wind_direction

# Графики
def plot_graphs(axs, air_pollution_list, wind_speed_list, wind_direction_list):
    for ax in axs:
        ax.cla()
    axs[0].plot(air_pollution_list)
    axs[0].set_title('Загрязнение воздуха')
    axs[1].plot(wind_speed_list, color='orange')
    axs[1].set_title('Скорость ветра')
    axs[2].plot(wind_direction_list, color='green')
    axs[2].set_title('Направление ветра')
    for ax in axs:
        ax.relim()
        ax.autoscale_view()

# Функция для отрисовки розы ветров с ориентацией norte вверх
def plot_wind_rose(ax, wind_direction, wind_speed, air_pollution, rotation_deg=0):
    ax.clear()
    ax.set_facecolor('white')
    ax.set_xlim(-1, 1)
    ax.set_ylim(-1, 1)

    def plot_three_lines(wind_speed, air_pollution, offset_deg=15, rotation=0):
# Названия сторон света
        directions = ['С', 'СЗ', 'З', 'ЮЗ', 'Ю', 'ЮВ', 'В', 'СВ']
# Начальные углы (без учета вращения)
        angles_deg = np.linspace(0, 360, len(directions), endpoint=False)
# Смещение, чтобы север был сверху (90 градусов)
        angles_deg = (angles_deg + 90) % 360
        angles_rad = np.deg2rad(angles_deg)

# Метки сторон
        for angle, label in zip(np.deg2rad(angles_deg), directions):
            x = 1.1 * np.cos(angle)
            y = 1.1 * np.sin(angle)
            ax.text(x, y, label, ha='center', va='center', fontsize=12)

# Основной угол по формуле
        base_angle_deg = (wind_speed * air_pollution) * (100 / 360)
        base_angle_deg = (base_angle_deg - 90 + rotation) % 360

# Радианы для линий
        angles_lines = [
            np.deg2rad((base_angle_deg + 90 + rotation) % 360),
            np.deg2rad(((base_angle_deg + offset_deg) + 90 + rotation) % 360),
            np.deg2rad(((base_angle_deg - offset_deg) + 90 + rotation) % 360)
        ]

        length = 0.8
        for angle in angles_lines:
            x_end = length * np.cos(angle)
            y_end = length * np.sin(angle)
            ax.plot([0, x_end], [0, y_end], color='red', linewidth=3)

# Центр
        ax.plot(0, 0, 'ko')
        ax.set_title(f'Основной угол: {int(base_angle_deg)}°', fontsize=14)
        ax.axis('off')

    plot_three_lines(wind_speed, air_pollution, offset_deg=15, rotation=rotation_deg)

# Основная функция
def cod():
    air_pollution, wind_speed, wind_direction = initial_air_pollution, initial_wind_speed, initial_wind_direction

    air_pollution_list = [air_pollution]
    wind_speed_list = [wind_speed]
    wind_direction_list = [wind_direction]

    plt.ion()
# создаем фигуры для графиков и розы ветров
    fig_graphs, axs_graphs = plt.subplots(1, 3, figsize=(15, 5))
    fig_graphs.canvas.manager.set_window_title('Графики')

    fig_rose, ax_rose = plt.subplots(figsize=(6, 6))
# установка названия окна
    fig_rose.canvas.manager.set_window_title('Роза ветров')

    try:
        while True:
# Генерация данных
            air_pollution, wind_speed, wind_direction = generate_data(
                air_pollution, wind_speed, wind_direction)

            air_pollution_list.append(air_pollution)
            wind_speed_list.append(wind_speed)
            wind_direction_list.append(wind_direction)

            print(f"Новое значение: Загрязнение={air_pollution:.2f}, Скорость={wind_speed:.2f}, Направление={wind_direction:.2f}°")

# Вычисляем вращение (случайно и с поправкой)
            base_rotation = np.random.uniform(-5, 5)
            rotate_amount = np.random.uniform(0, 360)
            total_rotation = (wind_direction + rotate_amount) % 360 + base_rotation

# Обновляем графики
            plot_graphs(axs_graphs, air_pollution_list, wind_speed_list, wind_direction_list)
            plot_wind_rose(ax_rose, wind_direction, wind_speed, air_pollution, rotation_deg=total_rotation)

            plt.pause(0.01)
            print("Ожидание 30 секунд перед следующими данными...")
            time.sleep(30)

    except KeyboardInterrupt:
        print("Завершение программы.")
    finally:
        plt.ioff()
        plt.show()

if __name__ == '__main__':
    cod()
