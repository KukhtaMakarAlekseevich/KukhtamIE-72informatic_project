import matplotlib.pyplot as plt
import numpy as np
import time

# --- Инициализация начальных данных ---
initial_air_pollution = 50
initial_wind_speed = 5
initial_wind_direction = 0

def generate_data(last_air_pollution, last_wind_speed, last_wind_direction):
    delta_pollution = (np.random.rand() - 0.5) * 10
    delta_speed = (np.random.rand() - 0.5) * 2
    delta_direction = (np.random.rand() - 0.5) * 20

    new_air_pollution = last_air_pollution + delta_pollution
    new_wind_speed = max(0, last_wind_speed + delta_speed)
    new_wind_direction = (last_wind_direction + delta_direction) % 360

    return new_air_pollution, new_wind_speed, new_wind_direction

def plot_graphs(axs, air_pollution_list, wind_speed_list, wind_direction_list):
    for ax in axs:
        ax.cla()  # очистка графика

    axs[0].plot(air_pollution_list, label='Загрязнение воздуха')
    axs[0].set_title('Загрязнение воздуха')
    axs[0].set_xlabel('Время')
    axs[0].set_ylabel('Уровень загрязнения')
    axs[0].legend()

    axs[1].plot(wind_speed_list, label='Скорость ветра', color='orange')
    axs[1].set_title('Скорость ветра')
    axs[1].set_xlabel('Время')
    axs[1].set_ylabel('М/с')
    axs[1].legend()

    axs[2].plot(wind_direction_list, label='Направление ветра', color='green')
    axs[2].set_title('Направление ветра')
    axs[2].set_xlabel('Время')
    axs[2].set_ylabel('Градыусы')
    axs[2].legend()

    for ax in axs:
        ax.relim()
        ax.autoscale_view()

    plt.draw()
    plt.pause(0.01)

def plot_wind_rose(ax, wind_speed, air_pollution):
    ax.cla()
    ax.set_facecolor('white')
    ax.set_xlim(-1, 1)
    ax.set_ylim(-1, 1)

    directions = ['С', 'СЗ', 'З', 'ЮЗ', 'Ю', 'ЮВ', 'В', 'СВ']
    angles_deg = np.linspace(0, 360, len(directions), endpoint=False)
    angles_deg = (angles_deg + 90) % 360

    # отметки направлений
    for angle, dir_label in zip(np.deg2rad(angles_deg), directions):
        x = 1.1 * np.cos(angle)
        y = 1.1 * np.sin(angle)
        ax.text(x, y, dir_label, ha='center', va='center', fontsize=12)

    # расчет угла по формуле с множителем 100
    angle_deg = (wind_speed * air_pollution) * (1000 / 360)
    angle_deg = angle_deg % 360
    radian = np.deg2rad((angle_deg + 90) % 360)

    # рисуем линию в сторону угла
    ax.plot([0, np.cos(radian)], [0, np.sin(radian)], color='red', linewidth=3)

    ax.plot(0, 0, 'ko')
    ax.set_title(f'Угол ветра по формуле\nНаправление: {int(angle_deg)}°', fontsize=14)
    ax.axis('off')
    plt.draw()
    plt.pause(0.01)

def cod():
    air_pollution = initial_air_pollution
    wind_speed = initial_wind_speed
    wind_direction = initial_wind_direction

    air_pollution_list = [air_pollution]
    wind_speed_list = [wind_speed]
    wind_direction_list = [wind_direction]

    plt.ion()  # интерактивный режим

    # Создаем окна для графиков и розы ветров
    fig_graphs, axs_graphs = plt.subplots(1, 3, figsize=(15, 5))
    fig_graphs.canvas.manager.set_window_title('Графики')

    fig_rose, ax_rose = plt.subplots(figsize=(6, 6))
    fig_rose.canvas.manager.set_window_title('Роза ветров')

    try:
        while True:
            # Генерация новых данных
            air_pollution, wind_speed, wind_direction = generate_data(
                air_pollution, wind_speed, wind_direction)

            # добавляем в списки
            air_pollution_list.append(air_pollution)
            wind_speed_list.append(wind_speed)
            wind_direction_list.append(wind_direction)

            # Обновляем графики
            plot_graphs(axs_graphs, air_pollution_list, wind_speed_list, wind_direction_list)

            # Обновляем розу ветров и отображаем рассчитанный угол
            plot_wind_rose(ax_rose, wind_speed, air_pollution)

            time.sleep(0.5)
    except KeyboardInterrupt:
        print("Прерывание по клавиатуре.")

if __name__ == '__main__':
    cod()
